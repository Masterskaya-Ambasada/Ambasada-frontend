//Хук для обрезки текста
import { useEffect, useRef, useState } from "react";

export const useClampText = (text: string) => {
  const ref = useRef<HTMLParagraphElement>(null);
  const [clamped, setClamped] = useState(text);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;

    let start = 0;
    let end = text.length;

    // если текст и так влезает — ничего не делаем
    el.innerText = text;
    if (el.scrollHeight <= el.clientHeight) return;

    // бинарный поиск 
    while (start < end) {
      const mid = Math.floor((start + end) / 2);
      el.innerText = text.slice(0, mid) + "...";

      if (el.scrollHeight > el.clientHeight) {
        end = mid - 1;
      } else {
        start = mid + 1;
      }
    }

    setClamped(text.slice(0, start - 1) + "...");
  }, [text]);

  return { ref, clamped };
};